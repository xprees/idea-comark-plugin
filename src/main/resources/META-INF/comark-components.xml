<idea-plugin>
    <!-- Component IntelliSense: discovery (cz.xprees.comark.meta), completion, navigation and documentation, and route links -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- Registered for Markdown: Comark is a Markdown dialect, and inline component text is Markdown PSI -->
        <completion.contributor language="Markdown"
                                implementationClass="cz.xprees.comark.completion.ComarkComponentCompletionContributor"/>
        <typedHandler implementation="cz.xprees.comark.completion.ComarkCompletionAutoPopupHandler"/>

        <gotoDeclarationHandler implementation="cz.xprees.comark.navigation.ComarkGotoDeclarationHandler"/>
        <!-- Find Usages / Rename of a component's .vue file: kebab-case and PascalCase usages in Comark files -->
        <referencesSearch implementation="cz.xprees.comark.navigation.ComarkComponentReferenceSearcher"/>
        <!-- Nuxt Content page routes in link destinations (/guide/install) resolve to their content files -->
        <psi.referenceContributor language="Markdown" implementation="cz.xprees.comark.navigation.ComarkRouteReferenceContributor"/>
        <!-- Nuxt image paths (public/ and Nuxt Image directories) in image destinations and image-like component attributes -->
        <psi.referenceContributor language="Markdown" implementation="cz.xprees.comark.images.ComarkImageReferenceContributor"/>
        <!-- Find Usages / Rename / Move of an image file (or a directory of images): its paths in Comark documents -->
        <referencesSearch implementation="cz.xprees.comark.images.ComarkImageReferenceSearcher"/>
        <lang.elementManipulator forClass="cz.xprees.comark.psi.ComarkAttributeValue"
                                 implementationClass="cz.xprees.comark.psi.ComarkAttributeValueManipulator"/>

        <platform.backend.documentation.targetProvider
                implementation="cz.xprees.comark.navigation.ComarkDocumentationTargetProvider"/>
        <platform.backend.documentation.psiTargetProvider
                implementation="cz.xprees.comark.navigation.ComarkPsiDocumentationTargetProvider"/>

        <localInspection language="Markdown" shortName="ComarkUnknownComponent"
                         bundle="messages.ComarkBundle" key="inspection.unknown.component.display.name"
                         groupKey="inspection.unknown.component.group"
                         enabledByDefault="false" level="WEAK WARNING"
                         implementationClass="cz.xprees.comark.meta.ComarkUnknownComponentInspection"/>
    </extensions>

    <projectListeners>
        <!-- tells image references which directory a Rename renames (see ComarkImageRenameTarget) -->
        <listener class="cz.xprees.comark.images.ComarkImageRenameTarget" topic="com.intellij.refactoring.listeners.RefactoringEventListener"/>
    </projectListeners>

    <actions>
        <action id="Comark.RefreshComponents" class="cz.xprees.comark.meta.ComarkRefreshComponentsAction"/>
    </actions>
</idea-plugin>
