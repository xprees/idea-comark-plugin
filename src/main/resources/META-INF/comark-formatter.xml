<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <!-- Reformat Code for Comark files: a port of the VS Code extension's formatter (falls back to Markdown's when disabled) -->
        <formattingService implementation="cz.xprees.comark.format.ComarkFormattingService"/>
        <!-- Auto-Indent Lines, adjustLineIndent, paste indentation: the same indentation as Reformat Code (Markdown's model when disabled) -->
        <lang.formatter language="Comark" implementationClass="cz.xprees.comark.format.ComarkFormattingModelBuilder"/>
        <!-- Code Style | Comark: the formatter's indent size (2 by default; Comark files would otherwise use Markdown's 4) -->
        <langCodeStyleSettingsProvider implementation="cz.xprees.comark.format.ComarkCodeStyleSettingsProvider"/>
        <notificationGroup id="Comark Formatter" displayType="BALLOON" bundle="messages.ComarkBundle" key="formatter.notification.group"/>

        <!-- Enter: new lines in component bodies and props start where the formatter would put them -->
        <lineIndentProvider implementation="cz.xprees.comark.format.ComarkLineIndentProvider"/>
        <!-- first: ahead of the Markdown plugin's list continuation (MarkdownListEnterHandlerDelegate, which has no id to order against) -->
        <enterHandlerDelegate implementation="cz.xprees.comark.format.ComarkEnterHandlerDelegate" order="first"/>
        <!-- props blocks: ahead of the YAML plugin's Enter handling of the injected YAML -->
        <editorActionHandler action="EditorEnter" implementationClass="cz.xprees.comark.format.ComarkPropsEnterHandler" order="first"/>

        <!-- Nuxt Studio style: what Studio would rewrite or convert (active in the Nuxt Studio and Custom styles) -->
        <localInspection language="Comark" shortName="ComarkStudioRewrite" enabledByDefault="true" level="WEAK WARNING"
                         bundle="messages.ComarkBundle" key="studio.inspection.rewrite.name"
                         groupBundle="messages.ComarkBundle" groupKey="highlighting.inspection.group"
                         implementationClass="cz.xprees.comark.format.ComarkStudioRewriteInspection"/>
        <localInspection language="Comark" shortName="ComarkStudioConversion" enabledByDefault="true" level="WEAK WARNING"
                         bundle="messages.ComarkBundle" key="studio.inspection.conversion.name"
                         groupBundle="messages.ComarkBundle" groupKey="highlighting.inspection.group"
                         implementationClass="cz.xprees.comark.format.ComarkStudioConversionInspection"/>
        <!-- the project uses another nuxt-studio / comark release than the Studio style reproduces -->
        <editorNotificationProvider implementation="cz.xprees.comark.format.ComarkStudioVersionNotificationProvider"/>
        <!-- offer the Nuxt Studio style in projects that depend on nuxt-studio -->
        <postStartupActivity implementation="cz.xprees.comark.format.ComarkStudioAdoptionActivity"/>
        <notificationGroup id="Comark Nuxt Studio" displayType="STICKY_BALLOON" bundle="messages.ComarkBundle" key="studio.notification.group"/>
    </extensions>
</idea-plugin>
