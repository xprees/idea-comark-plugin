<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin xmlns:xi="http://www.w3.org/2001/XInclude">
    <id>cz.xprees.comark</id>
    <name>Comark</name>
    <vendor url="https://github.com/xprees">xprees</vendor>
    <!-- <description> and <change-notes> are filled in from README.md / CHANGELOG.md by the Gradle build -->

    <depends>com.intellij.modules.platform</depends>
    <depends>org.intellij.plugins.markdown</depends>
    <depends optional="true" config-file="comark-yaml.xml">org.jetbrains.plugins.yaml</depends>
    <depends optional="true" config-file="comark-vue.xml">org.jetbrains.plugins.vue</depends>
    <depends optional="true" config-file="comark-spellchecker.xml">com.intellij.modules.spellchecker</depends>

    <resource-bundle>messages.ComarkBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Language: a Markdown dialect that Markdown files are switched to -->
        <fileType name="Comark" language="Comark" implementationClass="cz.xprees.comark.lang.ComarkFileType" fieldName="INSTANCE"/>
        <!-- .mdc files are Markdown files (preview, editor actions) that the substitutor turns into Comark -->
        <fileType name="Markdown" extensions="mdc"/>
        <fileIconProvider implementation="cz.xprees.comark.lang.ComarkFileIconProvider"/>
        <lang.substitutor language="Markdown" implementationClass="cz.xprees.comark.lang.ComarkLanguageSubstitutor"/>
        <lang.fileViewProviderFactory language="Comark" implementationClass="cz.xprees.comark.lang.ComarkFileViewProviderFactory"/>
        <lang.parserDefinition language="Comark" implementationClass="cz.xprees.comark.parser.ComarkParserDefinition"/>

        <applicationService serviceImplementation="cz.xprees.comark.settings.ComarkSettings"/>
        <applicationConfigurable parentId="language" id="cz.xprees.comark.settings"
                                 instance="cz.xprees.comark.settings.ComarkConfigurable"
                                 key="settings.display.name" bundle="messages.ComarkBundle"/>
    </extensions>

    <applicationListeners>
        <!-- installs and uninstalls without a restart: re-parses open Markdown files when the plugin is loaded or unloaded -->
        <listener class="cz.xprees.comark.lang.ComarkDynamicPluginListener" topic="com.intellij.ide.plugins.DynamicPluginListener"/>
    </applicationListeners>

    <!-- One file per feature area -->
    <xi:include href="/META-INF/comark-highlighting.xml" xpointer="xpointer(/idea-plugin/*)"/>
    <xi:include href="/META-INF/comark-formatter.xml" xpointer="xpointer(/idea-plugin/*)"/>
    <xi:include href="/META-INF/comark-editor.xml" xpointer="xpointer(/idea-plugin/*)"/>
    <xi:include href="/META-INF/comark-components.xml" xpointer="xpointer(/idea-plugin/*)"/>
    <xi:include href="/META-INF/comark-markdown-compat.xml" xpointer="xpointer(/idea-plugin/*)"/>

    <extensions defaultExtensionNs="org.intellij.markdown">
        <markdownCompatibilityChecker implementation="cz.xprees.comark.lang.ComarkCompatibilityChecker"/>
    </extensions>
</idea-plugin>
